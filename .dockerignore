# Don't ship development cruft into the build context

node_modules
bin
admin/node_modules
admin/.next
test
docs
*.md
# ...but the hosted skill catalog IS shipped. Docker matches *.md at every
# directory level, so without this negation every SKILL.md is stripped from
# the build context and the server serves an EMPTY catalog with a clean build.
!skills-hosted/**/*.md
!skills-hosted/*.md
.git
.github
.gitignore
.env*
*.log
*.bak
coverage
.cache
fly.toml.bak
